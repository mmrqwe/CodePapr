{
  "name": "codepapr",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Local-first coding agent with Tauri desktop workbench. Multi-agent collaboration with built-in Explore/Scout/Mentor sub-agents.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/@codepapr/types",
    "packages/@codepapr/common",
    "packages/@codepapr/core",
    "packages/@codepapr/api",
    "packages/@codepapr/editor",
    "packages/@codepapr/ui"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node ./scripts/run-workspace-tests.mjs",
    "harness:smoke": "node ./scripts/harness-smoke.mjs",
    "test:coverage": "node ./scripts/run-workspace-tests.mjs --run --coverage",
    "test:e2e:ui": "npm run test:e2e:ui --workspace=@codepapr/ui",
    "test:e2e:ui:install": "npm run test:e2e:ui:install --workspace=@codepapr/ui",
    "smoke:agent-tools": "node ./scripts/run-agent-tool-smoke.mjs",
    "smoke:desktop-diagnostics": "node ./scripts/run-desktop-diagnostics-smoke.mjs",
    "smoke:lsp-preview": "node ./scripts/run-desktop-lsp-smoke.mjs",
    "lint": "node ./scripts/run-module-bin.mjs eslint/bin/eslint.js \"packages/**/*.{ts,tsx,html}\" --max-warnings=0",
    "audit": "node ./scripts/run-audit.mjs --audit-level=low",
    "check:tauri": "node ./scripts/run-desktop-workflow.mjs root-check-tauri",
    "verify:ci": "npm run lint && npm run audit && npm run build && npm run test",
    "verify": "npm run verify:ci && npm run check:tauri",
    "debug": "node ./scripts/run-desktop-workflow.mjs root-debug",
    "release": "node ./scripts/run-desktop-workflow.mjs root-release",
    "publish": "node ./scripts/run-desktop-workflow.mjs root-publish",
    "release:dev": "npm run release:dev --workspace=@codepapr/ui",
    "release:run": "npm run release:run --workspace=@codepapr/ui",
    "build:desktop": "npm run build:tauri --workspace=@codepapr/ui",
    "release:prep": "npm run verify && node ./scripts/release-readiness.mjs",
    "publish:dry-run": "npm run release:prep && node ./scripts/publish-dry-run.mjs",
    "release:desktop": "npm run verify && npm run build:tauri --workspace=@codepapr/ui",
    "format": "node ./scripts/run-module-bin.mjs prettier/bin/prettier.cjs --write \"packages/**/*.{ts,tsx,json}\"",
    "dev": "npm run dev --workspace=@codepapr/ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.64.0",
    "@html-eslint/parser": "^0.64.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.0.0",
    "pyright": "^1.1.410",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "typescript-language-server": "^5.3.0",
    "vitest": "^4.1.6",
    "vscode-langservers-extracted": "^4.10.0",
    "yaml-language-server": "^1.23.0"
  },
  "overrides": {
    "brace-expansion": ">=5.0.8",
    "browserslist": ">=4.28.7",
    "fast-uri": ">=3.1.6 <4",
    "postcss-selector-parser": ">=6.1.3 <7"
  }
}
