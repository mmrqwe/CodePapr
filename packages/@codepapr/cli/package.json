{
  "name": "@codepapr/cli",
  "version": "0.1.0",
  "description": "CodePapr CLI 命令行工具",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codepapr": "./bin/codepapr.mjs"
  },
  "scripts": {
    "build": "node ../../../scripts/run-tsc-build.mjs",
    "dev": "node ../../../scripts/run-module-bin.mjs typescript/bin/tsc --watch",
    "start": "node ./bin/codepapr.mjs",
    "test": "node ../../../scripts/run-module-bin.mjs vitest/vitest.mjs"
  },
  "dependencies": {
    "@codepapr/types": "*",
    "@codepapr/common": "*",
    "@codepapr/core": "*",
    "@codepapr/api": "*",
    "@codepapr/db": "*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "vitest": "^4.1.6"
  },
  "license": "MIT"
}
