{
  "name": "@codepapr/ui",
  "version": "0.1.0",
  "license": "MIT",
  "description": "CodePapr - Tauri + React 桌面应用",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../../scripts/run-module-bin.mjs vite/bin/vite.js",
    "build:frontend": "node ../../../scripts/run-module-bin.mjs vite/bin/vite.js build",
    "preview": "node ../../../scripts/run-module-bin.mjs vite/bin/vite.js preview",
    "test": "node ../../../scripts/run-module-bin.mjs vitest/vitest.mjs",
    "test:e2e:ui": "node ../../../scripts/run-module-bin.mjs @playwright/test/cli.js test --config=playwright.config.ts",
    "test:e2e:ui:install": "node ../../../scripts/run-module-bin.mjs @playwright/test/cli.js install --with-deps chromium",
    "tauri": "node ../../../scripts/run-desktop-workflow.mjs ui-tauri",
    "debug": "node ../../../scripts/run-desktop-workflow.mjs ui-debug",
    "release:dev": "node ../../../scripts/run-desktop-workflow.mjs ui-release-dev",
    "release:run": "node ../../../scripts/run-desktop-workflow.mjs ui-release-run",
    "typecheck": "node ../../../scripts/run-module-bin.mjs typescript/bin/tsc -p tsconfig.json --noEmit",
    "prebuild:lsp": "node scripts/prebuild-lsp-servers.mjs",
    "build": "npm run typecheck && npm run build:frontend",
    "build:tauri": "node ../../../scripts/run-desktop-workflow.mjs ui-build-tauri",
    "release": "node ../../../scripts/run-desktop-workflow.mjs ui-build-tauri"
  },
  "dependencies": {
    "@codepapr/api": "*",
    "@codepapr/common": "*",
    "@codepapr/core": "*",
    "@codepapr/editor": "*",
    "@codepapr/types": "*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "katex": "^0.18.1",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tar": "^7.5.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
