{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the CodePapr desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "stronghold:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" },
        { "url": "http://localhost:**" }
      ]
    }
  ]
}
