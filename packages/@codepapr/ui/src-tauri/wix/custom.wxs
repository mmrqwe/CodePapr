<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- Add/Remove Programs description -->
    <Property Id="ARPCOMMENTS" Value="CodePapr - DeepSeek 缓存优化的本地 AI 编码助手。支持 CLI 自动化 + Tauri 桌面客户端，内置多 Agent 协作、CodeGraph 语义分析、15+ 语言 LSP 支持。" />
    <Property Id="ARPHELPLINK" Value="https://codepapr.com/" />

    <!-- Installer UI images (BMP format required by WiX) -->
    <WixVariable Id="WixUIBannerBmp" Value="wix\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="wix\dialog.bmp" />
  </Fragment>
</Wix>
