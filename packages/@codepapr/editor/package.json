{
  "name": "@codepapr/editor",
  "version": "0.1.0",
  "private": true,
  "description": "CodePapr - editor module",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../../scripts/run-tsc-build.mjs",
    "typecheck": "node ../../../scripts/run-module-bin.mjs typescript/bin/tsc --noEmit",
    "dev": "node ../../../scripts/run-module-bin.mjs typescript/bin/tsc --watch",
    "test": "node ../../../scripts/run-module-bin.mjs vitest/vitest.mjs"
  },
  "dependencies": {
    "@codepapr/types": "*",
    "@codepapr/common": "*",
    "@codepapr/core": "*"
  },
  "devDependencies": {
    "vitest": "^4.1.6"
  },
  "license": "MIT"
}
