[submodule ".cargo-vendor/c-sharp"]
	path = .cargo-vendor/c-sharp
	url = https://github.com/tree-sitter/tree-sitter-c-sharp
	ignore = dirty
[submodule ".cargo-vendor/css"]
	path = .cargo-vendor/css
	url = https://github.com/tree-sitter/tree-sitter-css
	ignore = dirty
[submodule ".cargo-vendor/html"]
	path = .cargo-vendor/html
	url = https://github.com/tree-sitter/tree-sitter-html
	ignore = dirty
[submodule ".cargo-vendor/json"]
	path = .cargo-vendor/json
	url = https://github.com/tree-sitter/tree-sitter-json
	ignore = dirty
[submodule ".cargo-vendor/kotlin"]
	path = .cargo-vendor/kotlin
	url = https://github.com/fwcd/tree-sitter-kotlin
	ignore = dirty
[submodule ".cargo-vendor/php"]
	path = .cargo-vendor/php
	url = https://github.com/tree-sitter/tree-sitter-php
	ignore = dirty
[submodule ".cargo-vendor/ruby"]
	path = .cargo-vendor/ruby
	url = https://github.com/tree-sitter/tree-sitter-ruby
	ignore = dirty
[submodule ".cargo-vendor/swift"]
	path = .cargo-vendor/swift
	url = https://github.com/alex-pinkus/tree-sitter-swift
	ignore = dirty
[submodule ".cargo-vendor/sql"]
	path = .cargo-vendor/sql
	url = https://github.com/DerekStride/tree-sitter-sql
	ignore = dirty
